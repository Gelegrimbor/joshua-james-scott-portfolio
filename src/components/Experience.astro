---
/**
 * Experience.astro — vertical timeline / career log from data/experience.ts.
 */
import Section from "./Section.astro";
import { EXPERIENCE } from "../data/experience";
---

<Section id="experience" index="02" label="experience" title="Experience">
  <ol class="relative" role="list">
    {
      EXPERIENCE.map((job, i) => (
        <li
          class="relative border-l border-border pb-12 pl-8 last:pb-0"
          data-reveal
          style={`transition-delay:${i * 60}ms`}
        >
          {/* Timeline node */}
          <span
            class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-accent ring-4 ring-bg"
            aria-hidden="true"
          />

          <p class="font-mono text-xs text-accent">
            {job.startDate} <span class="opacity-50">—</span> {job.endDate}
          </p>

          <h3 class="mt-2 text-xl font-semibold">
            {job.role}
            <span class="text-text"> · {job.company}</span>
          </h3>
          <p class="mt-1 font-mono text-xs text-text">{job.location}</p>

          <ul class="prose-measure mt-4 space-y-2 text-base" role="list">
            {job.bullets.map((b) => (
              <li class="relative pl-5">
                <span
                  class="absolute left-0 top-2.5 h-1.5 w-1.5 rounded-full bg-accent/60"
                  aria-hidden="true"
                />
                {b}
              </li>
            ))}
          </ul>

          <ul class="mt-4 flex flex-wrap gap-2" role="list">
            {job.stack.map((tech) => (
              <li class="rounded-md border border-border bg-surface px-2 py-1 font-mono text-xs text-text">
                {tech}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>
