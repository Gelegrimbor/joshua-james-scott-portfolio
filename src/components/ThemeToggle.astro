---
/**
 * ThemeToggle.astro — light/dark switch. Deliberately NOT a React island:
 * a tiny inline script keeps the zero-JS ethos. Persists to localStorage
 * (try/catch) and is safe if storage is blocked.
 */
import Icon from "./Icon.astro";
---

<button
  id="theme-toggle"
  type="button"
  class="flex h-10 w-10 items-center justify-center rounded-md text-text transition-colors duration-200 hover:text-accent hover:bg-surface"
  aria-label="Toggle colour theme"
  title="Toggle colour theme"
>
  <span class="icon-sun"><Icon name="sun" size={18} /></span>
  <span class="icon-moon"><Icon name="moon" size={18} /></span>
</button>

<style>
  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }
  :global([data-theme="light"]) .icon-sun {
    display: none;
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var current =
        document.documentElement.getAttribute("data-theme") === "light"
          ? "light"
          : "dark";
      var next = current === "light" ? "dark" : "light";
      document.documentElement.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {
        /* storage blocked — the choice just won't persist. */
      }
    });
  })();
</script>
