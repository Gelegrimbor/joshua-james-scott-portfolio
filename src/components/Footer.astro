---
/**
 * Footer.astro — minimal colophon.
 */
import { SITE } from "../site.config";
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div
    class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-3 px-5 pt-8 pb-28 text-sm sm:flex-row sm:items-center sm:px-8 sm:pt-10 sm:pb-28"
  >
    <p class="font-mono text-xs text-text">
      <span class="text-accent">&gt;_</span>
      {SITE.name} · © {year}
    </p>
    <p class="font-mono text-xs text-text">
      Built with Astro · Self-designed
    </p>
  </div>
</footer>
